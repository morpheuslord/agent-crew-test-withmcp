# Taskboard local configuration. `make up` copies this file to .env (git-ignored) on first run
# and replaces every __GENERATE__ with a fresh random value. Never commit .env.

# --- PostgreSQL ------------------------------------------------------------------------------
# Owner account: used only by the one-shot migrate job.
POSTGRES_OWNER_PASSWORD=__GENERATE__
# Least-privilege role the API connects as (created by `taskboard-admin migrate`).
DB_APP_PASSWORD=__GENERATE__

# --- Redis -----------------------------------------------------------------------------------
REDIS_PASSWORD=__GENERATE__

# --- Shared secrets (32+ characters each) ----------------------------------------------------
# Proves to the API that a request comes from the UI server (X-Service-Token).
SERVICE_AUTH_SECRET=__GENERATE__
# UI: derives the CSRF and cookie-signing keys.
COOKIE_SECRET=__GENERATE__
# API: derives each project's webhook signing key.
WEBHOOK_SIGNING_SECRET=__GENERATE__

# --- URLs and ports --------------------------------------------------------------------------
# Base URL used in password-reset emails (never taken from request headers).
PUBLIC_BASE_URL=http://localhost:3000
# Host port for the UI (bound to 127.0.0.1 only).
UI_PORT=3000

# --- Logging ---------------------------------------------------------------------------------
API_LOG_LEVEL=INFO
UI_LOG_LEVEL=info

# --- First admin (used by `make admin`; leave empty otherwise) ---------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Full variable reference. Compose sets these for each service from the values above; set them
# directly when running a service outside Compose (defaults in parentheses).
#
# API (api/src/taskboard/config.py):
#   ENVIRONMENT (production) development|test|production
#   LOG_LEVEL (INFO)  DEBUG|INFO|WARNING|ERROR
#   DATABASE_URL                     postgresql+psycopg://user:password@host:5432/db
#   MIGRATION_DATABASE_URL           owner URL for `taskboard-admin migrate`
#   DB_POOL_SIZE (5)
#   REDIS_URL                        redis://:password@host:6379/0 (rediss:// for TLS); unset = no cache
#   CACHE_TTL_SECONDS (300)
#   SERVICE_AUTH_SECRET              32+ characters
#   PUBLIC_BASE_URL                  https:// in production
#   SESSION_TTL_SECONDS (28800)  RESET_TOKEN_TTL_SECONDS (1800)
#   STORAGE_BACKEND (local) local|s3  STORAGE_LOCAL_PATH (/data/attachments)  S3_BUCKET  AWS_REGION
#   MAX_UPLOAD_BYTES (10485760)
#   WEBHOOK_SIGNING_SECRET           32+ characters
#   WEBHOOK_ALLOW_HTTP (false)  WEBHOOK_ALLOW_PRIVATE_TARGETS (false)  (both refused in production)
#   WEBHOOK_TIMEOUT_SECONDS (3)  WEBHOOK_MAX_ATTEMPTS (3)
#   LOGIN_MAX_FAILURES (5)  LOGIN_MAX_ACCOUNT_FAILURES (50)  LOGIN_MAX_ATTEMPTS_PER_IP (20)
#   FORGOT_MAX_PER_IP (5)  REGISTER_MAX_PER_IP (10)  RATE_LIMIT_WINDOW_SECONDS (900)
#   ADMIN_EMAIL, ADMIN_PASSWORD      only for `taskboard-admin create-admin`
#   DB_APP_PASSWORD                  only for `taskboard-admin migrate`
#
# UI (ui/src/config.ts):
#   NODE_ENV (production)  PORT (3000)  API_BASE_URL  SERVICE_AUTH_SECRET  COOKIE_SECRET
#   COOKIE_SECURE (true; must be true in production)  TRUST_PROXY_HOPS (0; 1 behind the ALB)
#   MAX_UPLOAD_BYTES (10485760)  API_TIMEOUT_MS (10000)  LOG_LEVEL (info) debug|info|warn|error
