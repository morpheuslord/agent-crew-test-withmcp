<%- include('partials/header') %>
<h1>Profile</h1>
<section class="card narrow">
  <p><strong><%= user.display_name %></strong></p>
  <p class="muted"><%= user.email %> · <%= user.role %></p>
</section>
<section class="card narrow">
  <h2>Change password</h2>
  <form method="post" action="/profile/password">
    <%- include('partials/csrf') %>
    <label>Current password <input type="password" name="current_password" required autocomplete="current-password"></label>
    <label>New password (12 characters or more) <input type="password" name="new_password" required minlength="12" maxlength="128" autocomplete="new-password"></label>
    <label>Confirm new password <input type="password" name="new_password_confirm" required minlength="12" maxlength="128" autocomplete="new-password"></label>
    <button type="submit">Change password</button>
  </form>
</section>
<%- include('partials/footer') %>
