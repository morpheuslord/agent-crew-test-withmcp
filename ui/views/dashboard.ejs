<%- include('partials/header') %>
<h1>Dashboard</h1>
<div class="grid">
  <section class="card">
    <h2>My teams</h2>
    <% if (teams.length === 0) { %><p class="muted">You are not in any team yet.</p><% } %>
    <ul>
      <% for (const team of teams) { %>
      <li><a href="/teams/<%= team.id %>"><%= team.name %></a></li>
      <% } %>
    </ul>
    <form method="post" action="/teams">
      <%- include('partials/csrf') %>
      <label>New team <input name="name" required maxlength="100"></label>
      <button type="submit">Create team</button>
    </form>
  </section>
  <section class="card">
    <h2>My projects</h2>
    <% if (projects.length === 0) { %><p class="muted">No projects yet.</p><% } %>
    <ul>
      <% for (const project of projects) { %>
      <li><a href="/projects/<%= project.id %>"><%= project.name %></a> <span class="muted"><%= project.teamName %><%= project.is_archived ? ' · archived' : '' %></span></li>
      <% } %>
    </ul>
  </section>
  <section class="card wide">
    <h2>Assigned to me</h2>
    <% if (assigned.length === 0) { %><p class="muted">Nothing assigned to you.</p><% } %>
    <table>
      <thead><tr><th>Task</th><th>Status</th><th>Priority</th><th>Due</th></tr></thead>
      <tbody>
        <% for (const task of assigned) { %>
        <tr><td><a href="/tasks/<%= task.id %>"><%= task.title %></a></td><td><%= task.status.replace('_', ' ') %></td><td><%= task.priority %></td><td><%= task.due_date || '' %></td></tr>
        <% } %>
      </tbody>
    </table>
  </section>
</div>
<%- include('partials/footer') %>
