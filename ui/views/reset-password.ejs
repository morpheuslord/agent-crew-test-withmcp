<%- include('partials/header') %>
<h1>Choose a new password</h1>
<% if (locals.error) { %><p class="flash flash-error" role="alert"><%= error %></p><% } %>
<form method="post" action="/reset-password" class="card narrow">
  <%- include('partials/csrf') %>
  <input type="hidden" name="token" value="<%= token %>">
  <label>New password (12 characters or more) <input type="password" name="password" required minlength="12" maxlength="128" autocomplete="new-password"></label>
  <label>Confirm password <input type="password" name="password_confirm" required minlength="12" maxlength="128" autocomplete="new-password"></label>
  <button type="submit">Set password</button>
</form>
<%- include('partials/footer') %>
